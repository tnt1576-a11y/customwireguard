[Unit]
Description=Keep the underlying CWG WireGuard port private
Before=wg-quick@cwg0.service cwg.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cwg/guard.nft
# Deliberately retain the drop rule on stop so stopping this unit never exposes
# the native WireGuard port. Remove the table only after stopping wg-quick@cwg0.

[Install]
WantedBy=multi-user.target
