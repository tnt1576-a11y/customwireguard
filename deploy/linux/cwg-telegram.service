[Unit]
Description=Optional owner-only CWG Telegram control
After=network-online.target cwg-telegram-admin.socket
Wants=network-online.target
Requires=cwg-telegram-admin.socket

[Service]
User=cwg-telegram
Group=cwg-telegram
LoadCredential=bot.json:/etc/cwg-telegram/bot.json
StateDirectory=cwg-telegram
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -B /usr/local/lib/cwg-telegram/telegram_bot.py
Restart=on-failure
RestartSec=20
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=64M
CPUQuota=10%
TasksMax=8
UMask=0077

[Install]
WantedBy=multi-user.target
