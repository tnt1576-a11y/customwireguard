<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CWG" Width="1060" Height="790" MinWidth="940" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0D1320" Foreground="#F1F5FC" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#98A6BE"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#E4EBF8"/><Setter Property="Background" Value="#243148"/><Setter Property="BorderBrush" Value="#33425B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="17,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#66E4C0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#ECF2FC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Shell" Padding="20,17" CornerRadius="14" Background="#182236" BorderBrush="#293A54" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><ContentPresenter/><Border x:Name="Dot" Grid.Column="1" Width="16" Height="16" CornerRadius="8" BorderBrush="#66778F" BorderThickness="1" VerticalAlignment="Top"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#5EE0B8"/><Setter TargetName="Shell" Property="Background" Value="#173431"/><Setter TargetName="Dot" Property="Background" Value="#5EE0B8"/><Setter TargetName="Dot" Property="BorderBrush" Value="#5EE0B8"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="#E0E9F9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#304159"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#25334B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="28,25,28,20">
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="2,4,0,7"><Border Width="39" Height="39" CornerRadius="12" Background="#61E2BC"><Path Stroke="#112B27" StrokeThickness="2.5" Data="M 11,12 L 19,8 L 27,12 L 27,22 L 19,28 L 11,22 Z M 15,18 L 18,21 L 24,14"/></Border><TextBlock Text="CWG" FontSize="28" FontWeight="SemiBold" Margin="11,0,0,0"/></StackPanel>
    <TextBlock Text="YOUR CONNECTION, YOUR CHOICE" FontSize="9" Foreground="#8496B3" Margin="2,8,0,30"/>
    <Border Background="#1B2B3D" CornerRadius="10" Padding="15,13"><TextBlock Text="Connection" FontWeight="SemiBold" Foreground="#73E5C4"/></Border>
    <TextBlock Text="A private route for your whole PC or just the apps you choose." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,22,12,0" LineHeight="23"/>
   </StackPanel>
   <StackPanel Grid.Row="2">
    <Border Background="#172232" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="Local devices stay reachable" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Your LAN connection is kept direct, including RDP." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/></StackPanel></Border>
    <TextBlock Text="CWG Desktop 0.6.3  ·  UDP transport" FontSize="11" Foreground="#6E819F" Margin="2,19,0,0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Make yourself at home." FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Choose a profile and how you want to connect." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="14" Padding="12,6" Background="#202D41"><TextBlock x:Name="StatusBadge" Text="Disconnected" FontSize="12" Foreground="#B8C6DA"/></Border></Grid>
   <Border Grid.Row="1" Background="#171F30" BorderBrush="#25334A" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,19"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR PROFILE" Foreground="#8397B5" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ProfileName" Text="No profile yet" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,4"/><TextBlock x:Name="Endpoint" Text="Import the .cwg file from your administrator." Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="ImportButton" Grid.Column="1" Content="Import configuration" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border>
   <StackPanel Grid.Row="2"><TextBlock Text="CONNECTION MODE" Foreground="#8B9DB8" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><RadioButton x:Name="FullMode" Style="{StaticResource Card}" GroupName="Mode" IsChecked="True"><StackPanel><TextBlock Text="Full PC" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="All apps use the tunnel." FontSize="12" Foreground="#A2B4C9" Margin="0,7,8,0"/></StackPanel></RadioButton><RadioButton x:Name="SplitMode" Grid.Column="2" Style="{StaticResource Card}" GroupName="Mode"><StackPanel><TextBlock Text="Split tunnel" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="You choose which apps." FontSize="12" Foreground="#A2B4C9" Margin="0,7,8,0"/></StackPanel></RadioButton></Grid></StackPanel>
   <Grid Grid.Row="3" Margin="0,18,0,16">
    <Border x:Name="FullPanel" Background="#111D2C" CornerRadius="14" Padding="22"><StackPanel VerticalAlignment="Center"><TextBlock Text="One connection for your whole PC" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Browsers, games and background apps use this profile.&#10;Your server connection and local network stay direct." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="23"/><TextBlock Text="Ready when you are." Foreground="#69D9BA" Margin="0,20,0,0"/></StackPanel></Border>
    <Grid x:Name="SplitPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="2,0,0,11"><RadioButton x:Name="IncludeMode" Content="Only these apps use CWG" IsChecked="True" GroupName="Rule" Foreground="#D4E2F3" Margin="0,0,22,0"/><RadioButton x:Name="ExcludeMode" Content="These apps bypass CWG" GroupName="Rule" Foreground="#D4E2F3"/></StackPanel><Border Grid.Row="1" Background="#111B2B" CornerRadius="12" BorderBrush="#25334A" BorderThickness="1"><Grid><ListBox x:Name="AppList" BorderThickness="0" Background="Transparent" Margin="6" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><TextBlock x:Name="EmptyHint" Text="Add an app or its installation folder.&#10;Folders also include helpers installed inside them." Foreground="#788CA9" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" LineHeight="24"/></Grid></Border><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="AddApp" Content="+  Add app" Padding="14,8"/><Button x:Name="AddFolder" Content="+  Add folder" Padding="14,8" Margin="8,0,0,0"/><Button x:Name="RemoveApp" Content="Remove" Padding="14,8" Margin="8,0,0,0" Background="Transparent"/></StackPanel></Grid>
   </Grid>
   <StackPanel Grid.Row="4"><TextBlock x:Name="Message" Text="Import a profile to get started." Foreground="#B4C4DC" TextWrapping="Wrap" Margin="2,0,0,10" MinHeight="21"/><Button x:Name="ConnectButton" Content="Connect" Background="#62E3BC" Foreground="#09251F" BorderBrush="#62E3BC" FontSize="18" FontWeight="SemiBold" Padding="20,15"/><TextBlock Text="DNS uses CWG while connected. Tunneled public IPv6 is blocked.&#10;Disconnecting restores normal networking; there is no kill switch after stop." Foreground="#7E91AE" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0" LineHeight="17"/></StackPanel>
  </Grid>
 </Grid>
</Window>
